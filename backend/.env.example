# Copy DATABASE_PUBLIC_URL from the PostgreSQL service in Railway.
DATABASE_URL=
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
